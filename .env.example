# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://scottie:scottie@localhost:5432/scottie_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Clerk Auth ──────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://...clerk.accounts.dev/.well-known/jwks.json

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Selects Scottie's reasoning provider — 'gemini' (default, MVP) or 'anthropic'
AI_PROVIDER=gemini

# Google Gemini — default provider (FREE tier, cost-effective for MVP/dev)
# Get key at: aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here

# Anthropic Claude — pluggable alternative, only required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — Whisper transcription only (server-side, NEVER in mobile app)
OPENAI_API_KEY=sk-...

# ─── Webhook Secrets (generate random strings for each) ──────────────────────
GITHUB_WEBHOOK_SECRET=your_random_secret_here
JIRA_WEBHOOK_SECRET=your_random_secret_here
LINEAR_WEBHOOK_SECRET=your_random_secret_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example for production: https://app.scottie.ai,https://scottie.ai
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
INTERNAL_API_URL=http://localhost:3001

# Service-to-service JWT — generate a long random string
SYSTEM_TOKEN=internal_system_jwt_for_service_to_service_calls

# Per-developer voice CLI token (each developer sets their own Clerk JWT)
AGENT_TOKEN=developer_personal_jwt

# ─── AI Identity ─────────────────────────────────────────────────────────────
# Set once the product name is finalised — never hardcode in source files
AI_NAME=Scottie
